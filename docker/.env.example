# Required: VLM for page transcription (main VLM, e.g. Qwen3.5-35B)
#
# NOTE: /v1/convert defaults to pipeline_mode=structured (the v2 single-model
# pipeline). In that mode VLM_URL/VLM_MODEL should point at the shrew-ocr
# per-page structured-extraction model (e.g. `shrew-9b`) served OpenAI-
# compatibly — it receives one page image per call and returns the 5-key
# JSON (metadata/summary/semantic_chunks/figures/tables) that the server
# assembles into the final document. The legacy multi-stage pipelines
# (pass pipeline_mode=vlm or pipeline_mode=conventional in the request)
# still use VLM_URL/VLM_MODEL as a general-purpose transcription VLM
# instead, e.g. Qwen3.5-35B.
VLM_URL=http://host.docker.internal:8000
VLM_MODEL=Qwen/Qwen3.5-35B
VLM_API_KEY=

# Optional: OpenRouter
# VLM_URL=https://openrouter.ai/api
# VLM_MODEL=qwen/qwen3.5-35b-a3b
# VLM_API_KEY=sk-or-...

# Tuning
VLM_CONCURRENCY=4
PIPELINE_CONCURRENCY=3
VLM_TIMEOUT_MARGIN=1.5
SHREW_PORT=8080
# SHREW_WORKERS=1
# SECTION_MAX_TOKENS=9000
# DOCLING_DEVICE=auto
# LOG_LEVEL=INFO
