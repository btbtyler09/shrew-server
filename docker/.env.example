# Required: the shrew-ocr-preview model endpoint.
#
# /v1/convert defaults to pipeline_mode=structured, the single-model pipeline.
# VLM_URL/VLM_MODEL must point at a shrew-ocr-preview server (Granite-Vision
# 4.1-4B base + the r256 LoRA, served with --enable-lora; see the deploy guide
# for the exact vLLM recipe). It takes one page per request and returns the
# 5-key JSON (metadata/summary/semantic_chunks/figures/tables) that the server
# assembles into the document.
#
# Two modalities, chosen automatically by file type:
#   pdf/image/office        -> rendered at 200 DPI, reduced to 100 DPI luminance
#   txt/md/html/csv/xlsx/...-> parsed by the deterministic extractor for that
#                              format, then sent as text
#
# pipeline_mode values:
#   structured (default) markdown + full structured JSON
#   raw                  the same extraction rendered as flat readable text
#                        (title, metadata, summary, then chunks/tables/figures);
#                        stage-3 keys are omitted from the response. Spreadsheets,
#                        csv and email skip the model entirely here — their
#                        deterministic parse is already the raw text.
#   vlm / conventional   legacy multi-stage pipelines; these use VLM_URL/VLM_MODEL
#                        as a general-purpose transcription VLM (e.g. Qwen3.5-35B)
#
# Sampling is fixed by the model contract (temperature 0, max_tokens 12000) and
# is NOT configurable — the model is validated as unconstrained greedy, and any
# decode knob invalidates its eval numbers.
VLM_URL=http://host.docker.internal:8012
VLM_MODEL=shrew-ocr-preview
VLM_API_KEY=

# Optional: OpenRouter
# VLM_URL=https://openrouter.ai/api
# VLM_MODEL=qwen/qwen3.5-35b-a3b
# VLM_API_KEY=sk-or-...

# Tuning
VLM_CONCURRENCY=4
PIPELINE_CONCURRENCY=3
VLM_TIMEOUT_MARGIN=1.5
SHREW_PORT=8080
# SHREW_WORKERS=1
# SECTION_MAX_TOKENS=9000
# DOCLING_DEVICE=auto
# LOG_LEVEL=INFO
