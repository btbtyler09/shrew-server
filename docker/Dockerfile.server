FROM python:3.12.15-slim-trixie

RUN apt-get update && apt-get upgrade -y \
    && apt-get install -y --no-install-recommends \
    libreoffice-core libreoffice-writer libreoffice-calc libreoffice-impress \
    fonts-liberation \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app
COPY pyproject.toml README.md LICENSE ./
COPY docker/requirements.lock ./
COPY app/ app/

RUN pip install --no-cache-dir pip==26.2.2 \
    && pip install --no-cache-dir -c requirements.lock .[server,figures]

# Pre-download heron-101 layout model for figure detection
RUN python -c "from transformers import RTDetrV2ForObjectDetection, RTDetrImageProcessor; \
    RTDetrV2ForObjectDetection.from_pretrained('ds4sd/docling-layout-heron-101'); \
    RTDetrImageProcessor.from_pretrained('ds4sd/docling-layout-heron-101')"

ENV HF_HUB_OFFLINE=1

# Which source this image was built from:
#   docker build --build-arg GIT_SHA=$(git rev-parse HEAD) --build-arg VERSION=0.5.0 ...
ARG GIT_SHA=unknown
ARG VERSION=unknown
LABEL org.opencontainers.image.title="shrew-server" \
      org.opencontainers.image.source="https://github.com/btbtyler09/shrew-server" \
      org.opencontainers.image.revision="${GIT_SHA}" \
      org.opencontainers.image.version="${VERSION}" \
      org.opencontainers.image.licenses="MIT"

EXPOSE 8080
CMD ["shrew", "serve"]
