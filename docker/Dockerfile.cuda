FROM ghcr.io/ggml-org/llama.cpp:server-cuda

ENV LD_LIBRARY_PATH="/app:${LD_LIBRARY_PATH}"

WORKDIR /models

# Qwen3.5-2B base model + vision projector
ADD https://huggingface.co/unsloth/Qwen3.5-2B-GGUF/resolve/main/Qwen3.5-2B-UD-Q8_K_XL.gguf \
    /models/Qwen3.5-2B.gguf
ADD https://huggingface.co/unsloth/Qwen3.5-2B-GGUF/resolve/main/mmproj-BF16.gguf \
    /models/mmproj.gguf

# Document Processing LoRA adapter (unified)
ADD https://huggingface.co/btbtyler09/shrew-2b/resolve/main/doc_processing/doc_processing.gguf \
    /models/adapters/doc_processing.gguf

HEALTHCHECK CMD ["curl", "-f", "http://localhost:8000/health"]
EXPOSE 8000
CMD ["--host", "0.0.0.0", "--port", "8000", \
     "--model", "/models/Qwen3.5-2B.gguf", \
     "--alias", "Qwen3.5-2B", \
     "--mmproj", "/models/mmproj.gguf", \
     "--lora-init-without-apply", \
     "--lora", "/models/adapters/doc_processing.gguf", \
     "-fa", "on", \
     "--ctx-size", "100000", \
     "--parallel", "4"]
