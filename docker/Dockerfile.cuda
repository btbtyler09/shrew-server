FROM ghcr.io/ggml-org/llama.cpp:server-cuda

WORKDIR /models

# Qwen3.5-2B base model
ADD https://huggingface.co/unsloth/Qwen3.5-2B-GGUF/resolve/main/Qwen3.5-2B-UD-Q8_K_XL.gguf \
    /models/Qwen3.5-2B.gguf

# Shrew LoRA adapters
ADD https://huggingface.co/btbtyler09/shrew-2b/resolve/main/extract_metadata/extract_metadata.gguf \
    /models/adapters/extract_metadata.gguf
ADD https://huggingface.co/btbtyler09/shrew-2b/resolve/main/summarize_document/summarize_document.gguf \
    /models/adapters/summarize_document.gguf
ADD https://huggingface.co/btbtyler09/shrew-2b/resolve/main/semantic_chunk_beta/semantic_chunk_beta.gguf \
    /models/adapters/semantic_chunk_beta.gguf

HEALTHCHECK CMD ["wget", "-qO-", "http://localhost:8000/health"]
EXPOSE 8000
CMD ["--host", "0.0.0.0", "--port", "8000", \
     "--model", "/models/Qwen3.5-2B.gguf", \
     "--lora-init-without-apply", \
     "--lora", "/models/adapters/extract_metadata.gguf", \
     "--lora", "/models/adapters/summarize_document.gguf", \
     "--lora", "/models/adapters/semantic_chunk_beta.gguf", \
     "--ctx-size", "24576", \
     "--parallel", "4", \
     "--reasoning-format", "none"]
